{
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:node/recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^(next|req|res|_)" }],
    "node/no-unpublished-require": "off",
    "node/no-missing-require": "off",
    "node/no-unsupported-features/es-syntax": ["error", { "version": ">=18.0.0" }],
    "no-process-exit": "off"
  }
}
