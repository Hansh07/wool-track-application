# ============================================================
# WOOL MONITORING ENTERPRISE v2 - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# SERVER
NODE_ENV=production
PORT=5000

# ============================================================
# MONGODB ATLAS (CLOUD DATABASE)
# ============================================================
# Steps to get connection string:
# 1. Go to https://cloud.mongodb.com
# 2. Create cluster → Connect → Drivers → Node.js
# 3. Copy the connection string below, replace placeholders
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?appName=Cluster0

# ============================================================
# JWT SECURITY
# ============================================================
# Generate strong secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_hex_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_64_byte_hex_refresh_secret_here
JWT_REFRESH_EXPIRE=7d

# ============================================================
# REDIS (CACHING + RATE LIMITING)
# ============================================================
# Local: redis://localhost:6379
# Redis Cloud: redis://<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ============================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# AI / EXTERNAL SERVICES
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================
# EMAIL (Nodemailer / Gmail App Password)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=WoolMonitor <no-reply@woolmonitor.com>

# ============================================================
# CLOUDINARY (IMAGE STORAGE & CDN)
# ============================================================
# Get from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# FRONTEND URL (CORS whitelist)
# ============================================================
CLIENT_URL=http://localhost:5173
PROD_CLIENT_URL=https://yourdomain.com

# ============================================================
# 2FA
# ============================================================
APP_NAME=WoolMonitor
